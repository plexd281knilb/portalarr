generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Settings {
  id               String    @id @default("global")
  mainPlexUrl      String?
  mainPlexToken    String?
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String?
  smtpFrom         String    @default("") // Email address the system sends books from
  refreshInterval  Int       @default(10)
  theme            String    @default("dark")
  autoSyncInterval Int       @default(6)
  lastAutoSync     DateTime?
  betaDashboardText String?
  roadmapText      String?
  alertBannerEnabled Boolean   @default(false)
  alertBannerText    String?
  downloadsPath      String?   @default("/downloads")
  aiProvider         String?   @default("default")
  aiApiKey           String?
  aiModel            String?   @default("gemini-2.5-flash")
  aiAutoResolve      Boolean   @default(true)
  googleBooksApiKey  String?
  defaultTrialDays   Int       @default(14)
  defaultPlexLibraries String?
  paymentPaypal      String?
  paymentVenmo       String?
  paymentCashApp     String?
  paymentZelle       String?
  paymentInstructions String?
  subscriptionPrice  String?
  yearlyPrice        Float?    @default(180)
  monthlyPrice       Float?    @default(15)
  renewalMonth       Int?      @default(1)
  renewalDay         Int?      @default(1)
  billingType        String?   @default("YEARLY_PRORATED")
  requireReferralForSignup Boolean @default(false)

  // Email Notification Controls
  emailNotificationsEnabled   Boolean   @default(true)
  notifyUserApproval          Boolean   @default(true)
  notifyAdminNewUserRequest   Boolean   @default(true)
  notifyPasswordReset         Boolean   @default(true)
  notifyMediaRequests         Boolean   @default(true)
  notifySupportTickets        Boolean   @default(true)
  notifySendToKindle          Boolean   @default(true)

  // Curation, Agregarr & Kometa (PMM) Settings
  tmdbApiKey                  String?
  traktClientId               String?
  mdblistApiKey               String?
  autoOverlaySync             Boolean   @default(true)
  autoCollectionSync          Boolean   @default(true)
  leavingSoonDiskThreshold    Int?      @default(15) // % free space threshold to flag leaving soon
  enableAutoPruneDeletion     Boolean   @default(false) // Safety master switch - OFF by default
  pruneDryRun                 Boolean   @default(true) // Dry run simulation mode - ON by default
  pruneTagCollection          Boolean   @default(true) // Tag '⚠️ Leaving Soon' Plex collection
  pruneApplyOverlays          Boolean   @default(true) // Apply warning poster overlay
  pruneDeleteFromArr          Boolean   @default(false) // Trigger deletion in Radarr/Sonarr
  pruneDeleteFromDisk         Boolean   @default(false) // Trigger direct disk deletion
  pruneDaysNotice             Int?      @default(14) // Days of advance notice before deletion
  pruneMinAgeDays             Int?      @default(90) // Min days item must exist before pruning eligibility
  pruneUnwatchedOnly          Boolean   @default(true) // Only prune items with 0 plays or unwatched
  enabledServersForOverlays   String?   // JSON array of server clientIdentifiers
  enabledServersForCollections String?  // JSON array of server clientIdentifiers
  enabledServersForPruning    String?   // JSON array of server clientIdentifiers
  comingSoonShares            String?   // JSON map of serverId -> share path e.g. {"main":"/mnt/user/coming_soon_main"}
  serverStorageConfig         String?   // JSON map of serverId -> { glancesUrl, shares, radarrId, sonarrId }

  // Agregarr Placeholder Overlay & Timing Controls
  placeholderTheatricalNoticeDays  Int?      @default(60) // Days before theatrical release to generate placeholder
  placeholderDigitalCountdownDays  Int?      @default(30) // Switch to "Streaming in X Days" within 30 days
  placeholderNowStreamingGraceDays Int?      @default(7)  // Keep "Now Streaming" for 7 days post-digital
  placeholderAutoPruneDays         Int?      @default(14) // Auto-prune dummy stub 14 days after release or acquisition
  placeholderBannerPosition        String?   @default("bottom") // "top", "bottom", "corner"
  placeholderBannerTheme           String?   @default("indigo-purple") // "indigo-purple", "emerald-green", "crimson-red", "amber-gold", "glass"
  placeholderCustomText            String?   // Custom subtitle text
  placeholderEnabled               Boolean   @default(true)
  
  // Leaving Soon Home Hub & Schedule Controls
  leavingSoonPromotedToHome        Boolean   @default(true)
  leavingSoonPromotedToRecommended Boolean   @default(true)
  leavingSoonPromotedToSharedHome  Boolean   @default(true)
  leavingSoonHomeOrder             Int?      @default(0) // #1 Top Priority
  leavingSoonAutoThresholdDays     Int?      @default(14) // Only show when items leaving within X days
  leavingSoonAutoHideEmpty         Boolean   @default(true) // Auto-hide from Home when 0 items leaving

  // Automated Curation Timer Job & Periodic Sync Controls
  curationSyncEnabled              Boolean   @default(true) // Master timer job switch
  curationSyncSchedule             String?   @default("every_6_hours") // "every_hour", "every_3_hours", "every_6_hours", "every_12_hours", "daily_3am", "custom"
  curationSyncCron                 String?   // Custom cron expression
  curationSyncOverlays             Boolean   @default(true) // Auto-scan new items and apply overlays
  curationSyncCollections          Boolean   @default(true) // Auto-sync seasonal & scheduled collections
  curationSyncReleases             Boolean   @default(true) // Auto-refresh upcoming digital releases & placeholders
  curationSyncPruning              Boolean   @default(true) // Auto-evaluate Leaving Soon candidates
  curationSyncParentalTags         Boolean   @default(true) // Auto-apply IMDb parental rating tags
  curationLastRunAt                DateTime?
  curationLastRunStatus            String?   // JSON telemetry summary of last execution

  // IMDb Parental Advisory & Rating Tagging Controls
  parentalTaggingEnabled           Boolean   @default(true)
  parentalTagFormat                String?   @default("prefix_category_severity") // "prefix_category_severity", "severity_category", "category_severity_paren", "custom"
  parentalTagPrefix                String?   @default("IMDb")
  parentalTagTarget                String?   @default("labels") // "labels" (Plex Sharing Labels), "genres" (Plex Genres), "both"
  parentalMinSeverity              String?   @default("Mild") // "Severe", "Moderate", "Mild", "None"
  parentalCategories               String?   @default("[\"nudity\",\"violence\",\"profanity\",\"alcohol\",\"frightening\"]") // JSON array
}

model TautulliInstance {
  id        String   @id @default(cuid())
  name      String
  url       String
  apiKey    String
  createdAt DateTime @default(now())
}

model GlancesInstance {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now())
}

model Service {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now())
}

model MediaApp {
  id          String   @id @default(cuid())
  type        String
  name        String
  url         String   // Internal IP
  externalUrl String?  // External/Public Link
  apiKey      String?
  enabledForUsers Boolean @default(false)
  allowedQualityProfileIds String?
  allowedRootFolderIds String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model User {
  id                     String    @id @default(cuid())
  username               String    @unique
  email                  String    @unique 
  password               String    // Hashed
  kindleEmail            String    @default("") // Send-to-Kindle email address
  role                   String    @default("USER") // "ADMIN", "SUPER_USER", "USER"
  status                 String    @default("APPROVED") // "APPROVED", "PENDING", "REJECTED", "TRIAL", "SUSPENDED", "EXPIRED"
  trialEndsAt            DateTime?
  subscriptionEndsAt     DateTime?
  plexUsername           String?
  plexEmail              String?
  plexLibrarySectionIds  String?   // Comma-separated list of Plex section IDs (e.g. "1,2,5")
  referralCode           String?   @unique
  referredByUserId       String?
  referredBy             User?     @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals              User[]    @relation("UserReferrals")
  contentPreference      UserContentPreference?
  convertedAt            DateTime? // When trial converted to paying subscriber
  lastLogin              DateTime? // Last time the user logged in
  createdAt              DateTime  @default(now())
}

model SupportTicket {
  id           String   @id @default(cuid())
  name         String   
  email        String   
  issue        String   
  status       String   @default("Pending") 
  adminComment String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- NEW MODEL ---
model BetaCard {
  id          String   @id @default(cuid())
  title       String
  content     String   // Holds your Markdown text
  buttonText  String?  
  buttonUrl   String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Library {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  path             String   @default("") // Path to the folder share inside the container
  allowedUsers     String   @default("") // Comma-separated list of usernames, or "*" for everyone
  restrictedUsers   String   @default("") // Comma-separated list of restricted usernames (explicit exclusion)
  downloadCategory String   @default("books") // Downloader client category (e.g. books, audiobooks)
  mediaType        String   @default("ebook") // "ebook" or "audiobook"
  books            Book[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String?
  series      String?  // Series name (e.g. "The Founders Trilogy", "Harry Potter")
  volumeNumber String? // Volume or book number (e.g. "1", "01")
  coverUrl    String?  // Optional cover image
  filePath    String   // Local path on disk to the PDF/EPUB/M4B/MP3/etc.
  fileSize    Float?   // Size in bytes (Float supports >2GB files up to 9 Petabytes)
  fileType    String   // "epub", "pdf", "m4b", "mp3", etc.
  mediaType   String   @default("ebook") // "ebook" or "audiobook"
  libraryId   String
  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BookRequest {
  id           String   @id @default(cuid())
  title        String
  author       String?
  series       String?  // Series name if requested as part of a series
  volumeNumber String?  // Volume or book number
  coverUrl     String?
  publishYear  String?
  requestedBy  String   // Username
  type         String   @default("book") // "book" or "series"
  mediaType    String   @default("ebook") // "ebook" or "audiobook"
  status       String   @default("Pending") // "Pending", "Approved", "Downloaded", "Rejected"
  monitorSeries Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model KindleDeliveryLog {
  id             String   @id @default(cuid())
  bookId         String?
  bookTitle      String
  bookAuthor     String?
  recipientEmail String   // Kindle email
  userEmail      String?  // User personal account email
  username       String   // Portalarr username
  status         String   @default("DELIVERED") // "DELIVERED", "FAILED", "WARNING"
  errorMessage   String?
  fileSize       Float?   // in bytes
  fileType       String?  // "epub", "pdf", etc.
  diagnostics    String?  // JSON or text summary of pre-flight/dispatch checks
  createdAt      DateTime @default(now())
}

model FailedRelease {
  id            String   @id @default(cuid())
  releaseTitle  String
  downloadUrl   String?
  guid          String?
  protocol      String   @default("torrent") // "torrent" or "usenet"
  reason        String?
  bookRequestId String?
  createdAt     DateTime @default(now())
}

model FeatureSuggestion {
  id          String        @id @default(cuid())
  title       String
  description String?
  category    String        @default("General")
  createdBy   String        @default("Admin")
  votes       FeatureVote[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model FeatureVote {
  id           String            @id @default(cuid())
  suggestionId String
  suggestion   FeatureSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  username     String
  createdAt    DateTime          @default(now())

  @@unique([suggestionId, username])
}

model EmailTemplate {
  id          String   @id // e.g. "user_approval", "password_reset", etc.
  name        String
  description String?
  subject     String
  body        String
  updatedAt   DateTime @default(now()) @updatedAt
}

model MediaCollection {
  id                   String    @id @default(cuid())
  title                String
  summary              String?
  sortTitle            String?
  type                 String    @default("curated") // "curated", "smart", "schedule", "dynamic", "custom", "seasonal"
  category             String?
  serverId             String?
  sectionKey           String?
  sourceType           String?   // "tmdb", "trakt", "mdblist", "plex_query", "manual"
  sourceQuery          String?
  rules                String?
  posterUrl            String?
  ratingKey            String?
  itemCount            Int       @default(0)
  autoSync             Boolean   @default(true)
  syncInterval         String    @default("daily")
  lastSyncedAt         DateTime?
  // Home Screen & Recommended Hub Ordering & Visibility
  orderIndex           Int       @default(0)
  promotedToHome       Boolean   @default(true)
  promotedToRecommended Boolean  @default(true)
  promotedToSharedHome Boolean   @default(true)
  sortPrefix           String?   @default("!00_")
  // Seasonal Scheduling Controls
  isSeasonal           Boolean   @default(false)
  scheduleStartMonth   Int?      // 1-12 (e.g. 10 for October)
  scheduleStartDay     Int?      // 1-31 (e.g. 1 for 1st)
  scheduleEndMonth     Int?      // 1-12 (e.g. 11 for November)
  scheduleEndDay       Int?      // 1-31 (e.g. 5 for 5th)
  seasonalAction       String?   @default("promote_hide") // "promote_hide", "keep_demoted", "create_delete"
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model MediaOverlayRule {
  id                String    @id @default(cuid())
  name              String
  serverId          String?
  sectionKey        String?
  overlayType       String    @default("combined")
  position          String    @default("top-right")
  videoPosition     String?   @default("top-right")
  audioPosition     String?   @default("top-left")
  editionPosition   String?   @default("bottom-right")
  ratingPosition    String?   @default("bottom-left")
  resolutionPosition String?   @default("top-right")
  hdrPosition       String?   @default("top-right")
  codecPosition     String?   @default("top-right")
  channelsPosition  String?   @default("top-left")
  studioPosition    String?   @default("bottom-left")
  contentRatingPosition String? @default("bottom-left")
  ratingsPosition   String?   @default("bottom-left")
  showRibbon        Boolean   @default(false)
  ribbonPosition    String    @default("top-right") // "top-right", "top-left", "bottom-right", "bottom-left"
  ribbonTheme       String    @default("purple")    // "crimson", "emerald", "purple", "gold", "cyan", "pink", "glass", "orange"
  ribbonText        String?                         // e.g. "4K UHD", "IMAX", "NEW RELEASE"
  ribbonType        String    @default("auto_quality") // "auto_quality", "auto_edition", "leaving_soon", "custom"
  theme             String    @default("glass")
  badgeStyle        String    @default("pill")
  showResolution    Boolean   @default(true)
  showHdr           Boolean   @default(true)
  showAudio         Boolean   @default(true)
  showRatings       Boolean   @default(false)
  showLeavingSoon   Boolean   @default(true)
  // Expanded Badge Toggles
  showAudioChannels Boolean   @default(false)
  showCodec         Boolean   @default(false)
  showEdition       Boolean   @default(false)
  showStudio        Boolean   @default(false)
  showContentRating Boolean   @default(false)
  customBadgeIds    String?   // JSON array of CustomBadge IDs to apply
  enabled           Boolean   @default(true)
  itemCount         Int       @default(0)
  lastAppliedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model CustomBadge {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("custom") // "quality", "edition", "studio", "rating", "custom", "banner"
  filePath    String   // Local path on disk to the uploaded badge image
  fileType    String   @default("png") // "png", "svg", "webp", "jpg"
  mimeType    String   @default("image/png")
  position    String   @default("top-right") // "top-right", "top-left", "bottom-right", "bottom-left", "top-center", "bottom-center"
  width       Int      @default(140)
  height      Int      @default(46)
  opacity     Float    @default(1.0)
  enabled     Boolean  @default(true)
  matchRule   String?  // JSON string or filter criteria e.g. {"resolution":"4K"} or {"genre":"Action"} or "all"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MediaArtBackup {
  id             String    @id @default(cuid())
  ratingKey      String
  serverId       String?
  title          String?
  originalArtUrl String?
  backupFilePath String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([serverId, ratingKey])
}

model UserContentPreference {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  excludedGenres   String?  // JSON array
  excludedTags     String?  // JSON array
  maxContentRating String?  // "ALL", "PG-13", "PG", "G"
  hideLeavingSoon  Boolean  @default(false)
  hideHorror       Boolean  @default(false)
  hideNsfw         Boolean  @default(false)
  hideGore         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MediaContentAdvisory {
  id                    String    @id @default(cuid())
  ratingKey             String
  serverId              String?
  title                 String?
  imdbId                String?
  tmdbId                String?
  mpaaRating            String?
  nudityLevel           String?
  violenceLevel         String?
  profanityLevel        String?
  alcoholLevel          String?
  frighteningLevel      String?
  digitalReleaseDate    DateTime?
  theatricalReleaseDate DateTime?
  inTheaters            Boolean   @default(false)
  isLeavingSoon         Boolean   @default(false)
  leavingSoonDate       DateTime?
  leavingReason         String?
  customTags            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([ratingKey, serverId])
}