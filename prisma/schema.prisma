generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Settings {
  id               String    @id @default("global")
  mainPlexUrl      String?
  mainPlexToken    String?
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String?
  refreshInterval  Int       @default(10)
  theme            String    @default("dark")
  autoSyncInterval Int       @default(6)
  lastAutoSync     DateTime?
  betaDashboardText String?
  roadmapText      String?
  alertBannerEnabled Boolean   @default(false)
  alertBannerText    String?
}

model TautulliInstance {
  id        String   @id @default(cuid())
  name      String
  url       String
  apiKey    String
  createdAt DateTime @default(now())
}

model GlancesInstance {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now())
}

model Service {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now())
}

model MediaApp {
  id          String   @id @default(cuid())
  type        String
  name        String
  url         String   // Internal IP
  externalUrl String?  // External/Public Link
  apiKey      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  email     String   @unique 
  password  String   // Hashed
  role      String   @default("USER") // "ADMIN" or "USER"
  createdAt DateTime @default(now())
}

model SupportTicket {
  id           String   @id @default(cuid())
  name         String   
  email        String   
  issue        String   
  status       String   @default("Pending") 
  adminComment String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- NEW MODEL ---
model BetaCard {
  id          String   @id @default(cuid())
  title       String
  content     String   // Holds your Markdown text
  buttonText  String?  
  buttonUrl   String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Library {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  allowedUsers String   @default("") // Comma-separated list of usernames, or "*" for everyone
  books        Book[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String?
  coverUrl    String?  // Optional cover image
  filePath    String   // Local path on disk to the PDF/EPUB/etc.
  fileSize    Int?     // Size in bytes
  fileType    String   // "epub", "pdf", "cbz", etc.
  libraryId   String
  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BookRequest {
  id          String   @id @default(cuid())
  title       String
  author      String?
  requestedBy String   // Username
  status      String   @default("Pending") // "Pending", "Approved", "Downloaded", "Rejected"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}