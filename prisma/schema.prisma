generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Settings {
  id               String    @id @default("global")
  mainPlexUrl      String?
  mainPlexToken    String?
  smtpHost         String?
  smtpPort         Int?
  smtpUser         String?
  smtpPass         String?
  smtpFrom         String    @default("") // Email address the system sends books from
  refreshInterval  Int       @default(10)
  theme            String    @default("dark")
  autoSyncInterval Int       @default(6)
  lastAutoSync     DateTime?
  betaDashboardText String?
  roadmapText      String?
  alertBannerEnabled Boolean   @default(false)
  alertBannerText    String?
  downloadsPath      String?   @default("/downloads")
  aiProvider         String?   @default("default")
  aiApiKey           String?
  aiModel            String?   @default("gemini-2.5-flash")
  aiAutoResolve      Boolean   @default(true)
  googleBooksApiKey  String?
}

model TautulliInstance {
  id        String   @id @default(cuid())
  name      String
  url       String
  apiKey    String
  createdAt DateTime @default(now())
}

model GlancesInstance {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now())
}

model Service {
  id        String   @id @default(cuid())
  name      String
  url       String
  createdAt DateTime @default(now())
}

model MediaApp {
  id          String   @id @default(cuid())
  type        String
  name        String
  url         String   // Internal IP
  externalUrl String?  // External/Public Link
  apiKey      String?
  enabledForUsers Boolean @default(false)
  allowedQualityProfileIds String?
  allowedRootFolderIds String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  email       String   @unique 
  password    String   // Hashed
  kindleEmail String   @default("") // Send-to-Kindle email address
  role        String   @default("USER") // "ADMIN" or "USER"
  status      String   @default("APPROVED") // "APPROVED", "PENDING", "REJECTED"
  lastLogin   DateTime? // Last time the user logged in
  createdAt   DateTime @default(now())
}

model SupportTicket {
  id           String   @id @default(cuid())
  name         String   
  email        String   
  issue        String   
  status       String   @default("Pending") 
  adminComment String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// --- NEW MODEL ---
model BetaCard {
  id          String   @id @default(cuid())
  title       String
  content     String   // Holds your Markdown text
  buttonText  String?  
  buttonUrl   String?  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Library {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  path             String   @default("") // Path to the folder share inside the container
  allowedUsers     String   @default("") // Comma-separated list of usernames, or "*" for everyone
  restrictedUsers   String   @default("") // Comma-separated list of restricted usernames (explicit exclusion)
  downloadCategory String   @default("books") // Downloader client category (e.g. books, audiobooks)
  mediaType        String   @default("ebook") // "ebook" or "audiobook"
  books            Book[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Book {
  id          String   @id @default(cuid())
  title       String
  author      String?
  series      String?  // Series name (e.g. "The Founders Trilogy", "Harry Potter")
  volumeNumber String? // Volume or book number (e.g. "1", "01")
  coverUrl    String?  // Optional cover image
  filePath    String   // Local path on disk to the PDF/EPUB/M4B/MP3/etc.
  fileSize    Float?   // Size in bytes (Float supports >2GB files up to 9 Petabytes)
  fileType    String   // "epub", "pdf", "m4b", "mp3", etc.
  mediaType   String   @default("ebook") // "ebook" or "audiobook"
  libraryId   String
  library     Library  @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BookRequest {
  id          String   @id @default(cuid())
  title       String
  author      String?
  series      String?  // Series name if requested as part of a series
  volumeNumber String? // Volume or book number
  coverUrl    String?
  publishYear String?
  requestedBy String   // Username
  type        String   @default("book") // "book" or "series"
  mediaType   String   @default("ebook") // "ebook" or "audiobook"
  status      String   @default("Pending") // "Pending", "Approved", "Downloaded", "Rejected"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}