{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "agy: Root Orchestrator (Gemini 3.8 Flash High - Default)",
      "type": "shell",
      "command": "agy --model gemini-3.8-flash-high",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "agy: Deep Architect (Gemini 4 Argon High - Escalation)",
      "type": "shell",
      "command": "agy --model gemini-4-argon-high",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "architect"
      }
    },
    {
      "label": "agy: Fallback Architect (Gemini 3.8 Flash High - Quota Fallback)",
      "type": "shell",
      "command": "agy --model gemini-3.8-flash-high",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "architect"
      }
    },
    {
      "label": "agy: Parallel Worker / Pinky (Gemini 3.8 Flash High)",
      "type": "shell",
      "command": "agy --model gemini-3.8-flash-high",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "workers"
      }
    },
    {
      "label": "agy: Quick Task on Flash (Print Mode)",
      "type": "shell",
      "command": "agy --model gemini-3.8-flash-high --print \"${input:prompt}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "agy: Light Recon & Search (Gemini 3.5 Flash Lite)",
      "type": "shell",
      "command": "agy --model gemini-3.5-flash-lite --print \"${input:prompt}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Portalarr: Run Integration Tests",
      "type": "shell",
      "command": "npm test",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Portalarr: Production Build",
      "type": "shell",
      "command": "npm run build",
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ],
  "inputs": [
    {
      "id": "prompt",
      "type": "promptString",
      "description": "Enter the prompt for the Gemini Flash worker"
    }
  ]
}
